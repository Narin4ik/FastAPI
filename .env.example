# Set values in the Pterodactyl egg/startup environment; Python does not auto-load this file.
# Generate each secret: python -c 'import secrets; print(secrets.token_hex(32))'
# Replace placeholders before startup. These placeholders are not valid production keys.
RELAY_KEYS_JSON={"discord-bot":"REPLACE_ME","telegram-bot":"REPLACE_ME"}
# Legacy alternative: PROXY_SECRET_128=<exactly 128 characters>, X-Proxy-Key defaults to "default".
HOST=0.0.0.0
PORT=8280
ALLOW_INSECURE_TRANSPORT=false
FORWARDED_ALLOW_IPS=127.0.0.1
ALLOWED_HOSTS=discord.com,gateway.discord.gg,*.gateway.discord.gg,cdn.discordapp.com,media.discordapp.net,api.telegram.org
# A value of 0 disables the respective limit.
MAX_CONCURRENT=0
MAX_PER_KEY=0
REQUESTS_PER_MINUTE=0
MAX_REQUEST_BYTES=0
MAX_RESPONSE_BYTES=0
TUNNEL_IDLE_SECONDS=180
TUNNEL_MAX_SECONDS=86400
# For direct TLS instead of Nginx termination:
# TLS_CERT_FILE=/home/container/tls/fullchain.pem
# TLS_KEY_FILE=/home/container/tls/privkey.pem
